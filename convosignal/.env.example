# Use a standard Databricks CLI profile (authenticate with databricks auth login).
DATABRICKS_CONFIG_PROFILE=YOUR_PROFILE
MLFLOW_TRACKING_URI=databricks://YOUR_PROFILE
MLFLOW_EXPERIMENT_ID=YOUR_EXPERIMENT_ID
CONVOSIGNAL_ENDPOINT=YOUR_CHAT_ENDPOINT
CONVOSIGNAL_TRACE_LIMIT=50
CONVOSIGNAL_TRACE_SHAPE=interaction
CONVOSIGNAL_QUESTION_PATH=query
CONVOSIGNAL_ANSWER_PATH=answer
CONVOSIGNAL_MESSAGES_PATH=messages
# Set only when session IDs are reliable; bounded sessions stay incomplete.
# CONVOSIGNAL_SESSION_PATH=session_id
CONVOSIGNAL_OUTPUT_DIR=results
CONVOSIGNAL_MAX_TOKENS=8000
CONVOSIGNAL_MAX_INPUT_CHARS=200000
# Alternative standard SDK authentication: configure host/token instead of a profile.
# DATABRICKS_HOST=https://YOUR_WORKSPACE_HOST
# DATABRICKS_TOKEN=YOUR_TOKEN
